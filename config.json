{
    "name": "Multi-CAPTCHA",
    "namespace": "YALE\\MultiCaptchaExternalModule",
    "description": "Protect public surveys with a CAPTCHA / bot-check service of your choice (Cloudflare Turnstile, Google reCAPTCHA v3, hCaptcha, or Friendly Captcha). Configurable globally with optional per-project override.",
    "authors": [
        {
            "name": "Bas de Veer",
            "email": "bas.deveer@yale.edu",
            "institution": "Yale University"
        }
    ],
    "framework-version": 14,
    "compatibility": {
        "redcap-version-min": "13.7.3",
        "php-version-min": "7.4.0"
    },

    "system-settings": [
        {
            "key": "sys-info",
            "name": "<b>Global default settings.</b> These apply to every project unless a project enables its own override below (and overrides are permitted).",
            "type": "descriptive"
        },
        {
            "key": "override_policy",
            "name": "<b>Project-level configuration override</b> — whether individual projects may use their own provider/keys instead of this global configuration.",
            "type": "dropdown",
            "choices": [
                { "value": "disabled", "name": "Disabled — projects cannot override; the global configuration always applies" },
                { "value": "user",     "name": "Enabled — configurable by project users (anyone with module-config rights)" },
                { "value": "admin",    "name": "Enabled — only configurable by administrators (REDCap super users)" }
            ]
        },
        {
            "key": "provider",
            "name": "Bot-check provider (global default)",
            "type": "dropdown",
            "choices": [
                { "value": "none",         "name": "None (disabled)" },
                { "value": "turnstile",    "name": "Cloudflare Turnstile" },
                { "value": "recaptcha_v3", "name": "Google reCAPTCHA v3" },
                { "value": "hcaptcha",     "name": "hCaptcha" },
                { "value": "friendly",     "name": "Friendly Captcha" }
            ]
        },

        { "key": "turnstile_help", "type": "descriptive",
          "name": "<b>Cloudflare Turnstile.</b> Get keys: <a href='https://dash.cloudflare.com/?to=/:account/turnstile' target='_blank'>Cloudflare dashboard &rarr; Turnstile</a> &middot; <a href='https://developers.cloudflare.com/turnstile/get-started/' target='_blank'>Setup docs</a>",
          "branchingLogic": { "conditions": [ { "field": "provider", "value": "turnstile" } ] } },
        { "key": "turnstile_sitekey", "name": "Turnstile — Site key", "type": "text",
          "branchingLogic": { "conditions": [ { "field": "provider", "value": "turnstile" } ] } },
        { "key": "turnstile_secret", "name": "Turnstile — Secret key", "type": "text",
          "branchingLogic": { "conditions": [ { "field": "provider", "value": "turnstile" } ] } },

        { "key": "recaptcha_help", "type": "descriptive",
          "name": "<b>Google reCAPTCHA v3.</b> Create keys (select reCAPTCHA <i>v3</i>): <a href='https://www.google.com/recaptcha/admin/create' target='_blank'>reCAPTCHA admin console</a> &middot; <a href='https://developers.google.com/recaptcha/docs/v3' target='_blank'>v3 docs</a>",
          "branchingLogic": { "conditions": [ { "field": "provider", "value": "recaptcha_v3" } ] } },
        { "key": "recaptcha_sitekey", "name": "reCAPTCHA v3 — Site key", "type": "text",
          "branchingLogic": { "conditions": [ { "field": "provider", "value": "recaptcha_v3" } ] } },
        { "key": "recaptcha_secret", "name": "reCAPTCHA v3 — Secret key", "type": "text",
          "branchingLogic": { "conditions": [ { "field": "provider", "value": "recaptcha_v3" } ] } },
        { "key": "recaptcha_threshold", "name": "reCAPTCHA v3 — Minimum passing score (0.0–1.0, default 0.5)", "type": "text",
          "branchingLogic": { "conditions": [ { "field": "provider", "value": "recaptcha_v3" } ] } },

        { "key": "hcaptcha_help", "type": "descriptive",
          "name": "<b>hCaptcha.</b> Sign up &amp; get keys: <a href='https://dashboard.hcaptcha.com/signup' target='_blank'>hCaptcha dashboard</a> &middot; <a href='https://docs.hcaptcha.com/' target='_blank'>Developer docs</a>",
          "branchingLogic": { "conditions": [ { "field": "provider", "value": "hcaptcha" } ] } },
        { "key": "hcaptcha_sitekey", "name": "hCaptcha — Site key", "type": "text",
          "branchingLogic": { "conditions": [ { "field": "provider", "value": "hcaptcha" } ] } },
        { "key": "hcaptcha_secret", "name": "hCaptcha — Secret key", "type": "text",
          "branchingLogic": { "conditions": [ { "field": "provider", "value": "hcaptcha" } ] } },

        { "key": "friendly_help", "type": "descriptive",
          "name": "<b>Friendly Captcha.</b> Create an application + API key: <a href='https://developer.friendlycaptcha.com/docs/getting-started/client' target='_blank'>Getting started</a> &middot; <a href='https://developer.friendlycaptcha.com/' target='_blank'>Developer hub</a>. <i>This module targets the v1 siteverify endpoint.</i>",
          "branchingLogic": { "conditions": [ { "field": "provider", "value": "friendly" } ] } },
        { "key": "friendly_sitekey", "name": "Friendly Captcha — Site key", "type": "text",
          "branchingLogic": { "conditions": [ { "field": "provider", "value": "friendly" } ] } },
        { "key": "friendly_secret", "name": "Friendly Captcha — API key (secret)", "type": "text",
          "branchingLogic": { "conditions": [ { "field": "provider", "value": "friendly" } ] } },

        { "key": "debug", "name": "Global debug mode (log to browser console)", "type": "checkbox" }
    ],

    "project-settings": [
        {
            "key": "override-note",
            "name": "<i>Note: project-level override is controlled by your REDCap administrator. It may be disabled (the global configuration is always used) or restricted to administrators only. If so, the checkbox below has no effect for you.</i>",
            "type": "descriptive"
        },
        {
            "key": "override",
            "name": "<b>Override global settings</b> and use the project-specific provider configuration below.",
            "type": "checkbox"
        },
        {
            "key": "always",
            "name": "Always require the check (present on every survey load, not just once per session)",
            "type": "checkbox"
        },
        {
            "key": "p_provider",
            "name": "Bot-check provider (this project)",
            "type": "dropdown",
            "choices": [
                { "value": "none",         "name": "None (disabled)" },
                { "value": "turnstile",    "name": "Cloudflare Turnstile" },
                { "value": "recaptcha_v3", "name": "Google reCAPTCHA v3" },
                { "value": "hcaptcha",     "name": "hCaptcha" },
                { "value": "friendly",     "name": "Friendly Captcha" }
            ],
            "branchingLogic": { "conditions": [ { "field": "override", "value": true } ] }
        },

        { "key": "p_turnstile_help", "type": "descriptive",
          "name": "<b>Cloudflare Turnstile.</b> Get keys: <a href='https://dash.cloudflare.com/?to=/:account/turnstile' target='_blank'>Cloudflare dashboard &rarr; Turnstile</a> &middot; <a href='https://developers.cloudflare.com/turnstile/get-started/' target='_blank'>Setup docs</a>",
          "branchingLogic": { "type": "and", "conditions": [ { "field": "override", "value": true }, { "field": "p_provider", "value": "turnstile" } ] } },
        { "key": "p_turnstile_sitekey", "name": "Turnstile — Site key", "type": "text",
          "branchingLogic": { "type": "and", "conditions": [ { "field": "override", "value": true }, { "field": "p_provider", "value": "turnstile" } ] } },
        { "key": "p_turnstile_secret", "name": "Turnstile — Secret key", "type": "text",
          "branchingLogic": { "type": "and", "conditions": [ { "field": "override", "value": true }, { "field": "p_provider", "value": "turnstile" } ] } },

        { "key": "p_recaptcha_help", "type": "descriptive",
          "name": "<b>Google reCAPTCHA v3.</b> Create keys (select reCAPTCHA <i>v3</i>): <a href='https://www.google.com/recaptcha/admin/create' target='_blank'>reCAPTCHA admin console</a> &middot; <a href='https://developers.google.com/recaptcha/docs/v3' target='_blank'>v3 docs</a>",
          "branchingLogic": { "type": "and", "conditions": [ { "field": "override", "value": true }, { "field": "p_provider", "value": "recaptcha_v3" } ] } },
        { "key": "p_recaptcha_sitekey", "name": "reCAPTCHA v3 — Site key", "type": "text",
          "branchingLogic": { "type": "and", "conditions": [ { "field": "override", "value": true }, { "field": "p_provider", "value": "recaptcha_v3" } ] } },
        { "key": "p_recaptcha_secret", "name": "reCAPTCHA v3 — Secret key", "type": "text",
          "branchingLogic": { "type": "and", "conditions": [ { "field": "override", "value": true }, { "field": "p_provider", "value": "recaptcha_v3" } ] } },
        { "key": "p_recaptcha_threshold", "name": "reCAPTCHA v3 — Minimum passing score (0.0–1.0, default 0.5)", "type": "text",
          "branchingLogic": { "type": "and", "conditions": [ { "field": "override", "value": true }, { "field": "p_provider", "value": "recaptcha_v3" } ] } },

        { "key": "p_hcaptcha_help", "type": "descriptive",
          "name": "<b>hCaptcha.</b> Sign up &amp; get keys: <a href='https://dashboard.hcaptcha.com/signup' target='_blank'>hCaptcha dashboard</a> &middot; <a href='https://docs.hcaptcha.com/' target='_blank'>Developer docs</a>",
          "branchingLogic": { "type": "and", "conditions": [ { "field": "override", "value": true }, { "field": "p_provider", "value": "hcaptcha" } ] } },
        { "key": "p_hcaptcha_sitekey", "name": "hCaptcha — Site key", "type": "text",
          "branchingLogic": { "type": "and", "conditions": [ { "field": "override", "value": true }, { "field": "p_provider", "value": "hcaptcha" } ] } },
        { "key": "p_hcaptcha_secret", "name": "hCaptcha — Secret key", "type": "text",
          "branchingLogic": { "type": "and", "conditions": [ { "field": "override", "value": true }, { "field": "p_provider", "value": "hcaptcha" } ] } },

        { "key": "p_friendly_help", "type": "descriptive",
          "name": "<b>Friendly Captcha.</b> Create an application + API key: <a href='https://developer.friendlycaptcha.com/docs/getting-started/client' target='_blank'>Getting started</a> &middot; <a href='https://developer.friendlycaptcha.com/' target='_blank'>Developer hub</a>. <i>This module targets the v1 siteverify endpoint.</i>",
          "branchingLogic": { "type": "and", "conditions": [ { "field": "override", "value": true }, { "field": "p_provider", "value": "friendly" } ] } },
        { "key": "p_friendly_sitekey", "name": "Friendly Captcha — Site key", "type": "text",
          "branchingLogic": { "type": "and", "conditions": [ { "field": "override", "value": true }, { "field": "p_provider", "value": "friendly" } ] } },
        { "key": "p_friendly_secret", "name": "Friendly Captcha — API key (secret)", "type": "text",
          "branchingLogic": { "type": "and", "conditions": [ { "field": "override", "value": true }, { "field": "p_provider", "value": "friendly" } ] } },

        { "key": "p_debug", "name": "Project debug mode (log to browser console)", "type": "checkbox" }
    ]
}
